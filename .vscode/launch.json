{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Install & run dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm install && npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    }
  ]
}
