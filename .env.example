# Copy to .env.local for local development. On Netlify, set these under
# Site configuration → Environment variables. Never commit real values.

# Required for live chat answers. Without it, the chat runs in retrieval-only mode.
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b (tool calling, available on the free Developer plan).
GROQ_MODEL=openai/gpt-oss-120b

# Optional. Questions per visitor IP per day (best effort). Defaults to 30.
CHAT_DAILY_LIMIT=30

# Optional. Enables meaning-based (semantic) search for the chat. Free Pinecone Starter key from
# https://app.pinecone.io. Pinecone embeds the content itself (llama-text-embed-v2), so no other key is needed.
# Without it, the chat uses keyword search only.
PINECONE_API_KEY=

# Optional. Index name, created automatically on the first sync. Defaults to portfolio-chat.
PINECONE_INDEX=portfolio-chat

# Optional. Used when the main model hits its rate limit (Groq limits are per model). Defaults to openai/gpt-oss-20b.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
